@model Hotel.Models.Room
@{
    ViewData["Title"] = "Редактировать номер";
}

<div class="container py-5" style="max-width:640px">
    <h2 class="fw-bold mb-4"><i class="bi bi-pencil me-2 text-warning"></i>Редактировать номер @Model.RoomNumber</h2>

    <form asp-action="Edit" method="post" class="card border-0 shadow-sm p-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
            <input asp-for="RoomNumber" class="form-control">
            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label fw-semibold"></label>
            <select asp-for="Type" class="form-select"
                    asp-items="Html.GetEnumSelectList<Hotel.Models.RoomType>()"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col">
                <label asp-for="PricePerNight" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="PricePerNight" class="form-control" type="number" min="1" step="0.01">
                    <span class="input-group-text">$</span>
                </div>
                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
            </div>
            <div class="col">
                <label asp-for="Capacity" class="form-label fw-semibold"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="10">
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
            <input asp-for="ImageUrl" class="form-control">
        </div>

        <div class="mb-4 form-check">
            <input asp-for="IsAvailable" class="form-check-input" type="checkbox">
            <label asp-for="IsAvailable" class="form-check-label">Номер доступен</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning fw-semibold flex-fill">
                <i class="bi bi-save me-1"></i>Сохранить изменения
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
