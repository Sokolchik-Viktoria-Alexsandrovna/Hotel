@model Hotel.Models.Room
@{
    ViewData["Title"] = "Номер " + Model.RoomNumber;
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-7">
            <img src="@Model.ImageUrl" class="img-fluid rounded-3 shadow w-100" style="max-height:420px;object-fit:cover"
                 alt="Номер @Model.RoomNumber"
                 onerror="this.src='https://via.placeholder.com/700x420?text=No+Image'">
        </div>
        <div class="col-lg-5">
            <span class="badge bg-warning text-dark fs-6 mb-2">@Model.Type</span>
            <h2 class="fw-bold">Номер @Model.RoomNumber</h2>
            <p class="text-muted">@Model.Description</p>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item d-flex justify-content-between">
                    <span><i class="bi bi-cash me-2 text-warning"></i>Цена за ночь</span>
                    <strong>@Model.PricePerNight $</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span><i class="bi bi-people me-2 text-warning"></i>Вместимость</span>
                    <strong>до @Model.Capacity человек</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span><i class="bi bi-circle-fill me-2 @(Model.IsAvailable ? "text-success" : "text-danger")"></i>Статус</span>
                    <strong>@(Model.IsAvailable ? "Доступен" : "Занят")</strong>
                </li>
            </ul>

            @if (Model.IsAvailable)
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Reservations" asp-action="Create" asp-route-roomId="@Model.Id"
                       class="btn btn-warning btn-lg w-100 fw-semibold">
                        <i class="bi bi-calendar-plus me-2"></i>Забронировать
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg w-100 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Войдите для бронирования
                    </a>
                }
            }
            else
            {
                <button class="btn btn-secondary btn-lg w-100" disabled>Номер занят</button>
            }

            <a asp-action="Index" class="btn btn-link w-100 mt-2 text-muted">← Назад к списку</a>

            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-pencil me-1"></i>Редактировать
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill">
                        <i class="bi bi-trash me-1"></i>Удалить
                    </a>
                </div>
            }
        </div>
    </div>
</div>
