@model IEnumerable<Hotel.Models.Room>
@{
    ViewData["Title"] = "Добро пожаловать";
}

<!-- Hero -->
<section class="hero-section text-white text-center d-flex align-items-center justify-content-center"
         style="min-height:480px; background: linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)), url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?w=1400') center/cover no-repeat;">
    <div>
        <h1 class="display-4 fw-bold mb-3">Добро пожаловать в Grand Hotel</h1>
        <p class="lead mb-4">Роскошь, комфорт и безупречный сервис в самом центре города</p>
        <a asp-controller="Rooms" asp-action="Index" class="btn btn-warning btn-lg px-5 fw-semibold">
            <i class="bi bi-search me-2"></i>Посмотреть номера
        </a>
    </div>
</section>

<!-- Преимущества -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <i class="bi bi-wifi fs-1 text-warning"></i>
                <h5 class="mt-3">Бесплатный Wi-Fi</h5>
                <p class="text-muted">Высокоскоростной интернет во всех номерах и зонах отеля</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-cup-hot fs-1 text-warning"></i>
                <h5 class="mt-3">Завтрак включён</h5>
                <p class="text-muted">Шведский стол с 7:00 до 10:30 для всех гостей отеля</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-check fs-1 text-warning"></i>
                <h5 class="mt-3">Безопасность</h5>
                <p class="text-muted">Круглосуточная охрана и видеонаблюдение на всей территории</p>
            </div>
        </div>
    </div>
</section>

<!-- Популярные номера -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">Популярные номера</h2>
        <div class="row g-4">
            @foreach (var room in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@room.ImageUrl" class="card-img-top" style="height:220px;object-fit:cover"
                             alt="Номер @room.RoomNumber" onerror="this.src='https://via.placeholder.com/400x220?text=No+Image'">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0">№ @room.RoomNumber</h5>
                                <span class="badge bg-warning text-dark">@room.Type</span>
                            </div>
                            <p class="card-text text-muted small">@room.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fw-bold fs-5 text-dark">@room.PricePerNight $ / ночь</span>
                                <span class="text-muted"><i class="bi bi-people me-1"></i>@room.Capacity чел.</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id"
                               class="btn btn-outline-dark w-100">Подробнее</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-dark btn-lg px-5">
                Все номера <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>
