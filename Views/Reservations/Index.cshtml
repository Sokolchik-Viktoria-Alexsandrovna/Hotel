@model IEnumerable<Hotel.Models.Reservation>
@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Все бронирования" : "Мои бронирования";
}

<div class="bg-dark text-white py-4">
    <div class="container">
        <h1 class="fw-bold mb-0">
            <i class="bi bi-calendar-check me-2 text-warning"></i>@ViewData["Title"]
        </h1>
    </div>
</div>

<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Нет активных бронирований</h4>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-warning mt-3">
                <i class="bi bi-search me-1"></i>Найти номер
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        @if (User.IsInRole("Admin"))
                        {
                            <th>Гость</th>
                        }
                        <th>Номер</th>
                        <th>Тип</th>
                        <th>Заезд</th>
                        <th>Выезд</th>
                        <th>Ночей</th>
                        <th>Итого</th>
                        <th>Дата брони</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="small">@r.User?.Email</td>
                            }
                            <td><strong>№ @r.Room?.RoomNumber</strong></td>
                            <td><span class="badge bg-warning text-dark">@r.Room?.Type</span></td>
                            <td>@r.CheckIn.ToString("dd.MM.yyyy")</td>
                            <td>@r.CheckOut.ToString("dd.MM.yyyy")</td>
                            <td>@r.Nights</td>
                            <td class="fw-bold">@r.TotalPrice $</td>
                            <td class="text-muted small">@r.BookingDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@r.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Cancel" asp-route-id="@r.Id" method="post"
                                          onsubmit="return confirm('Отменить бронирование?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
